# Server & Database
NODE_ENV=development
PORT=5000
DATABASE_URL="file:./dev.db"
# For Docker Postgres:
# DATABASE_URL="postgresql://vlab:vlabpassword@db:5432/vlab_db?schema=public"

# Authentication
